# DexterHouse configuration. Copy to `.env`; never commit `.env`.
# Secrets (Django key, Fernet key, runner key, Postgres password) are generated on first start
# by the `secrets-init` service into the `dh_secrets` volume: leave SECRET_KEY empty.

# Images and ports
DH_IMAGE_PREFIX=ghcr.io/francescoridolfi
DH_VERSION=0.1.0
HTTP_PORT=80
TZ=UTC

# Django
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DATABASE_URL=postgres://dexterhouse@postgres:5432/dexterhouse
REDIS_URL=redis://redis:6379/0

# Processes
WEB_WORKERS=2
WORKER_CONCURRENCY=4
CLI_MAX_CONCURRENT=2

# Organization defaults
DEFAULT_ORG_SLUG=default
DEFAULT_LANGUAGE=en
TELEMETRY_ENABLED=false

# LLM providers (at least one key, or point to Ollama)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Marketplace and registry
MARKETPLACE_URL=https://marketplace.dexterhouse.dev
REGISTRY_INDEX_URL=https://raw.githubusercontent.com/francescoridolfi/dexterhouse-registry/main/index.json

# Workspaces (runner)
WORKSPACE_EGRESS_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org,github.com,objects.githubusercontent.com
WORKSPACE_IMAGE_ALLOWLIST=ghcr.io/francescoridolfi/dexterhouse-workspace
RUNNER_RUNTIME=runc
WORKSPACE_IDLE_DESTROY_H=24
WORKSPACE_CPUS=2
WORKSPACE_MEM=2g
WORKSPACE_DISK=5G

# Events, logs, costs
EVENTS_RETENTION_MONTHS=12
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=
PRICES_FILE=
FX_EUR_PER_USD=
