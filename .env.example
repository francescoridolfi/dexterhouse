# DexterHouse configuration. Copy to `.env`; never commit `.env`.
# Secrets (Django key, Fernet key, runner key, Postgres password) are generated on first start
# by the `secrets-init` service into the `dh_secrets` volume: leave SECRET_KEY empty.

# Images and ports
DH_IMAGE_PREFIX=ghcr.io/francescoridolfi
DH_VERSION=0.1.0
HTTP_PORT=80
TZ=UTC
# Production with TLS (compose.prod.yaml): the public domain, served by Caddy on 80 and 443.
CADDY_DOMAIN=
HTTPS_PORT=443

# Django
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,web
# Every origin browsers use, with the port when it is not 80/443: http://localhost:8080.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# Session and CSRF cookies need HTTPS (http://localhost is exempt in browsers); false only for
# plain HTTP on a trusted network.
COOKIE_SECURE=true
DATABASE_URL=postgres://dexterhouse@postgres:5432/dexterhouse
REDIS_URL=redis://redis:6379/0

# Processes
WEB_WORKERS=2
WORKER_CONCURRENCY=4
CLI_MAX_CONCURRENT=2

# Rate limits (empty = off): per API token or user, per anonymous IP, login attempts per IP.
# API_TRUSTED_PROXIES = reverse proxies in front of web (1 = nginx; compose.prod.yaml sets 2).
API_RATE_CLIENT=600/min
API_RATE_ANON=60/min
API_RATE_LOGIN=10/min
API_TRUSTED_PROXIES=1
# WebSocket connections per project per browser session or token (4429 beyond).
WS_CONNECTIONS_PER_PROJECT=1

# Organization defaults
DEFAULT_ORG_SLUG=default
DEFAULT_LANGUAGE=en
TELEMETRY_ENABLED=false

# LLM providers (at least one key, or point to Ollama)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Claude Code CLI provider (opt-in, see docs/providers/anthropic-cli.md)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_HOME=
CLI_TIMEOUT_S=600

# Marketplace and registry (docs/recruiter.md). MARKETPLACE_URL is reserved for the marketplace
# site API (not used in 1.0); MARKETPLACE_RAW_URL reads package files from a non-GitHub host,
# e.g. https://git.example.com/{path}/-/raw/{ref}/{file}; PACKAGES_GIT_MIRRORS is JSON.
MARKETPLACE_URL=https://marketplace.dexterhouse.dev
REGISTRY_INDEX_URL=https://raw.githubusercontent.com/francescoridolfi/dexterhouse-registry/main/index.json
MARKETPLACE_RAW_URL=
PACKAGES_GIT_MIRRORS={}
# Installed packages (volume `packages`); local paths and git+file:// sources only in development
PACKAGES_DIR=/data/packages
PACKAGES_ALLOW_LOCAL=false

# Workspaces (runner). Build the workspace images once with
# `docker compose --profile images build` (or pull them from the registry of DH_IMAGE_PREFIX).
WORKSPACE_EGRESS_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org,github.com,objects.githubusercontent.com,proxy.golang.org,sum.golang.org
WORKSPACE_IMAGE_ALLOWLIST=ghcr.io/francescoridolfi/dexterhouse-workspace
WORKSPACE_PULL=true
RUNNER_RUNTIME=runc
RUNNER_CONCURRENCY=8
# Label of this stack's workspaces; empty = the Compose project name (docs/install.md).
RUNNER_INSTALLATION=
WORKSPACE_IDLE_DESTROY_H=24
WORKSPACE_CPUS=2
WORKSPACE_MEM=2g
WORKSPACE_DISK=5G

# Events, logs, costs
EVENTS_RETENTION_MONTHS=12
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=
PRICES_FILE=
FX_EUR_PER_USD=

# Gate notifications by email (E-06). In development compose.override.yaml points them at
# Mailpit (http://localhost:8025). The SMTP password goes in a file, never here.
NOTIFICATIONS_EMAIL=false
PUBLIC_URL=http://localhost
DEFAULT_FROM_EMAIL=DexterHouse <noreply@localhost>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD_FILE=
EMAIL_USE_TLS=false
# Demo without LLM: answer the `fake` provider with the built-in demo responder
# (set the organization's model profiles to provider `fake`).
# GATEWAY_FAKE_RESPONDER=dexterhouse.apps.agents.demo.respond
GATEWAY_FAKE_RESPONDER=
