# SPDX-License-Identifier: AGPL-3.0-or-later
# DexterHouse frontend: Vite build served by nginx. Build context: repository root.
#   docker build -f docker/Dockerfile.frontend -t dexterhouse-frontend .

# --- build ---------------------------------------------------------------------------------
FROM node:26.13.0-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216 AS build

WORKDIR /app/src/frontend
ENV CI=true

COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY src/frontend/ ./
RUN npm run build

# --- runtime -------------------------------------------------------------------------------
FROM nginx:1.31.7-alpine@sha256:892bb2152464f0c5d8972593a5f5afaf8054552580b699d95f8ff4af08c2d33d

LABEL org.opencontainers.image.title="dexterhouse-frontend" \
      org.opencontainers.image.description="DexterHouse web UI (nginx + Vite build)" \
      org.opencontainers.image.source="https://github.com/francescoridolfi/dexterhouse" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

# Alpine fixes land before the nginx image is rebuilt (Trivy, docker/scan-images.sh).
RUN apk upgrade --no-cache

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/src/frontend/dist/ /usr/share/nginx/html/

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1/healthz || exit 1
