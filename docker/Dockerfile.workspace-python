# syntax=docker/dockerfile:1
# Workspace image `python` (stack.language: python): uv, pip, git, make, gcc, detect-secrets,
# ruff, pre-commit and the workspace MCP server. Built from the repository root.
ARG BASE=python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.29@sha256:eb2843a1e56fd9e30c7276ce1a52cba86e64c7b385f5e3279a0e08e02dd058fc
FROM ${UV_IMAGE} AS uv
FROM ${BASE}
COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends git make gcc libc6-dev curl ca-certificates procps sqlite3 \
    && pip install --no-cache-dir --disable-pip-version-check ruff==0.17.3 pre-commit==4.7.0
COPY docker/workspace/setup.sh docker/workspace/requirements.txt /tmp/dh-setup/
COPY src/runner/dexterhouse_runner/__init__.py /tmp/dh-setup/dexterhouse_runner/__init__.py
COPY src/runner/dexterhouse_runner/workspace_mcp /tmp/dh-setup/dexterhouse_runner/workspace_mcp
RUN sh /tmp/dh-setup/setup.sh python3
ENV HOME=/home/dh \
    HTTP_PROXY=http://proxy:3128 HTTPS_PROXY=http://proxy:3128 \
    http_proxy=http://proxy:3128 https_proxy=http://proxy:3128 \
    NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 \
    PIP_INDEX_URL=https://pypi.org/simple npm_config_registry=https://registry.npmjs.org/ \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
USER 1000:1000
# The container lives; the runner works in it with `docker exec`.
ENTRYPOINT ["sleep", "infinity"]
