# syntax=docker/dockerfile:1
# Workspace image `full` (mixed stacks, language: other): Python 3.12 + uv, Node 22, Go 1.23,
# build-essential, sqlite, git, detect-secrets and the workspace MCP server.
ARG BASE=debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ARG GO_IMAGE=golang:1.23-bookworm@sha256:167053a2bb901972bf2c1611f8f52c44d5fe7e762e5cab213708d82c421614db
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.29@sha256:eb2843a1e56fd9e30c7276ce1a52cba86e64c7b385f5e3279a0e08e02dd058fc
FROM ${PYTHON_IMAGE} AS python
FROM ${NODE_IMAGE} AS node
FROM ${GO_IMAGE} AS go
FROM ${UV_IMAGE} AS uv
FROM ${BASE}
COPY --from=python /usr/local /usr/local
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /uvx /usr/local/bin/
ENV PATH=/usr/local/go/bin:$PATH
RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential curl ca-certificates procps sqlite3 \
       libexpat1 libsqlite3-0 libffi8 libssl3 zlib1g libbz2-1.0 liblzma5 libreadline8 libncursesw6 \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && corepack enable \
    && ldconfig
COPY docker/workspace/setup.sh docker/workspace/requirements.txt /tmp/dh-setup/
COPY src/runner/dexterhouse_runner/__init__.py /tmp/dh-setup/dexterhouse_runner/__init__.py
COPY src/runner/dexterhouse_runner/workspace_mcp /tmp/dh-setup/dexterhouse_runner/workspace_mcp
RUN sh /tmp/dh-setup/setup.sh python3
ENV HOME=/home/dh \
    HTTP_PROXY=http://proxy:3128 HTTPS_PROXY=http://proxy:3128 \
    http_proxy=http://proxy:3128 https_proxy=http://proxy:3128 \
    NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 \
    PIP_INDEX_URL=https://pypi.org/simple npm_config_registry=https://registry.npmjs.org/ \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
USER 1000:1000
# The container lives; the runner works in it with `docker exec`.
ENTRYPOINT ["sleep", "infinity"]
